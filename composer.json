{
    "name": "hardcastle/ledger-direct-sw6",
    "description": "LedgerDirect - Shopware6 Ledger & Blockchain Connector",
    "version": "1.1.0",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Busse",
            "homepage": "https://www.ledger-direct.com",
            "role": "Developer"
        }
    ],
    "extra": {
        "shopware-plugin-class": "Hardcastle\\LedgerDirect\\LedgerDirect",
        "author": "Hardcastle Technologies | Alexander Busse",
        "label": {
            "de-DE": "LedgerDirect",
            "en-GB": "LedgerDirect"
        },
        "manufacturerLink": {
            "de-DE": "https://www.ledger-direct.com",
            "en-GB": "https://www.ledger-direct.com"
        },
        "supportLink": {
            "de-DE": "https://www.ledger-direct.com/contact/",
            "en-GB": "https://www.ledger-direct.com/contact/"
        },
        "description": {
            "de-DE": "LedgerDirect nimmt XRP-, RLUSD- und USDC-Zahlungen direkt über das XRP Ledger in Ihre eigene Wallet an, ohne Mittelsmann, ohne Gebühren und ohne externen Zahlungsdienstleister.",
            "en-GB": "LedgerDirect lets your Shopware store accept XRP, RLUSD and USDC directly on the XRP Ledger, into a wallet you control, without middlemen, fees or an external provider."
        }
    },
    "require": {
        "php": "^8.2",
        "hardcastle/ledger-direct-core": "^0.2.0",
        "shopware/core": "~6.6.5 || ~6.7.0",
        "shopware/storefront": "~6.6.5 || ~6.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Hardcastle\\LedgerDirect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hardcastle\\LedgerDirect\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    }
}
