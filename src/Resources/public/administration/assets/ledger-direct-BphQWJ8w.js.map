{% block sw_order_detail_details_payment %}
    {% parent %}

    <ledger-direct-payment-card
        v-if="transaction && isLedgerDirectTransaction"
        :order-transaction-id="transaction.id"
    />

    <ledger-direct-received-payments
        v-if="ledgerDirectReceivedPaymentsKey"
        :key="ledgerDirectReceivedPaymentsKey"
        :order-id="orderId"
    />
{% endblock %}
