{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_body_classes %}{{ parent() }} ld-body{% endblock %}

{% block base_body_inner %}

    {% set basicConfig = config('core.basicInformation') %}

    {% if paymentPageTitle %}
        <div class="ld-header">
            <h2>{{ paymentPageTitle }}</h2>
        </div>
    {% endif %}

    <div class="ld-container" data-xrp-payment-page="true">
        <div class="ld-content">

            <div class="ld-card">

                <div class="ld-card-left">
                    {% if mode == 'xrp' %}
                        <p>{{ "LedgerDirect.paymentPage.sendXrpMessage"|trans({"%amount%": amountRequestedDisplay})|raw }}</p>
                        {# Read by the wallet integrations; same string the customer is shown. #}
                        <input id="xrp-amount"
                               type="text"
                               name="xrp-amount"
                               value="{{ amountRequestedDisplay }}"
                               readonly
                               style="display: none;"
                        />
                    {% elseif mode == 'rlusd' || mode == 'usdc' %}
                        <p>{{ "LedgerDirect.paymentPage.sendTokenMessage"|trans({"%amount%": amountRequestedDisplay, "%tokenName%": mode|upper})|raw}}</p>
                        <input id="token-amount"
                               type="text"
                               name="token-amount"
                               value="{{ amountRequestedDisplay }}"
                               readonly
                               style="display: none;"
                        />
                    {% endif %}

                    <div class="ld-payment-info">
                    <span>
                        {{ "LedgerDirect.paymentPage.destinationAccountLabel"|trans }}
                        {% sw_include '@LedgerDirect/storefront/ledger-direct/svg/wallet_svg.html.twig' with {
                            class: 'inline-svg',
                            height:'16',
                            width:'16',
                            viewBox: '0 0 24 24'
                        } %}
                    </span>
                        <div class="ld-payment-info-text">
                            <div id="destination-account" class="" data-value="{{ destinationAccount }}">
                                {{ destinationAccount }}
                            </div>
                            <div class="ld-payment-info-functions">
                                {% sw_include '@LedgerDirect/storefront/ledger-direct/svg/copy_svg.html.twig' with { class: 'action-svg' } %}
                                {% sw_include '@LedgerDirect/storefront/ledger-direct/svg/qr_svg.html.twig' with { class: 'action-svg' } %}
                            </div>
                        </div>
                    </div>

                    <div class="ld-payment-info">
                    <span>
                        {{ "LedgerDirect.paymentPage.destinationTagLabel"|trans }}
                        {% sw_include '@LedgerDirect/storefront/ledger-direct/svg/tag_svg.html.twig' with {
                            class: 'inline-svg',
                            height:'16',
                            width:'16',
                            viewBox: '0 0 24 24'
                        } %}
                    </span>
                        <div class="ld-payment-info-text">
                            <div id="destination-tag" class="" data-value="{{ destinationTag }}">
                                {{ destinationTag }}
                            </div>
                            <div class="ld-payment-info-functions">
                                {% sw_include '@LedgerDirect/storefront/ledger-direct/svg/copy_svg.html.twig' with { class: 'action-svg' } %}
                                {% sw_include '@LedgerDirect/storefront/ledger-direct/svg/qr_svg.html.twig' with { class: 'action-svg' } %}
                            </div>
                        </div>
                    </div>

                    {% if amountPaid %}
                        <div class="ld-warning">
                            <div role="alert" class="alert alert-info alert-has-icon">
                                <div class="alert-content-container">
                                    <div class="alert-content">
                                        {% if wrongToken %}
                                            {{ "LedgerDirect.paymentPage.wrongTokenNotice"|trans({
                                                "%paid%": amountPaid,
                                                "%shortfall%": shortfall,
                                                "%tokenName%": mode|upper
                                            })|raw }}
                                        {% else %}
                                            {{ "LedgerDirect.paymentPage.partialPaymentNotice"|trans({
                                                "%paid%": amountPaid,
                                                "%shortfall%": shortfall
                                            })|raw }}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <div class="ld-warning">
                        <div role="alert" class="alert alert-warning alert-has-icon">
                            <div class="alert-content-container">
                                <div class="alert-content">
                                    {{ "LedgerDirect.paymentPage.destinationTagWarning"|trans }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="ld-sync">
                        <!--
                        <button id="gem-wallet-button" class="wallet-disabled">G</button>
                        <button id="crossmark-wallet-button" class="wallet-disabled">C</button>
                        <button id="xumm-wallet-button" class="wallet-disabled">X</button>
                        -->
                        <button id="check-payment-button" data-order-id="{{ orderId }}" data-deep-link-code="{{ deepLinkCode }}">
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="display:none"></span>
                            {{ "LedgerDirect.paymentPage.checkPaymentButton"|trans }}
                        </button>
                    </div>

                </div>

                <div class="ld-card-right">
                    {#
                        One block for all three assets. It used to be two
                        copy-pasted branches, which is how a hard-coded "RLUSD"
                        survived in the USDC path until recently.
                    #}
                    {% set assetLabel = mode|upper %}
                    <div class="ld-sum">{{ total|currency }}</div>
                    <span>{{ "LedgerDirect.paymentPage.orderNumber"|trans }}: {{ orderNumber }}</span><br/>
                    <span>{{ "LedgerDirect.paymentPage.total"|trans }}: {{ amountRequestedDisplay }} {{ assetLabel }}</span><br/>
                    <span>{{ "LedgerDirect.paymentPage.exchangeRate"|trans }}: {{ exchangeRateDisplay }} {{ assetLabel }} / {{ currencyCode }}</span><br/>
                    <span>{{ "LedgerDirect.paymentPage.network"|trans }}: {{ network }}</span>
                </div>

            </div>

            <div class="ld-footer">
                <a href="{{ path('frontend.checkout.cart.page') }}" class="ld-back-to-cart">
                    {{ "LedgerDirect.paymentPage.backToCart"|trans }}
                </a>
            </div>

        </div>
    </div>

{% endblock %}