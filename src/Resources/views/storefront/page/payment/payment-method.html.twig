{% sw_extends '@Storefront/storefront/component/payment/payment-method.html.twig' %}

{#
    The LedgerDirect payment methods carry no media logo in the database; the
    icons ship with the plugin and are chosen by handler. Every other method
    keeps the storefront's rendering.
#}
{% block component_payment_method_image %}
    {% set ledgerDirectIcon = null %}
    {% if 'XrpPaymentHandler' in payment.handlerIdentifier %}
        {% set ledgerDirectIcon = 'xrp' %}
    {% elseif 'RlusdPaymentHandler' in payment.handlerIdentifier %}
        {% set ledgerDirectIcon = 'rlusd' %}
    {% elseif 'UsdcPaymentHandler' in payment.handlerIdentifier %}
        {% set ledgerDirectIcon = 'usdc' %}
    {% endif %}

    {% if ledgerDirectIcon %}
        <img class="payment-method-image"
             src="{{ asset('bundles/ledgerdirect/storefront/img/' ~ ledgerDirectIcon ~ '_payment.svg', 'asset') }}"
             alt="{{ payment.translated.name }}"
             title="{{ payment.translated.name }}"
             width="40"
             height="40">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
